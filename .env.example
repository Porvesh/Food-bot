# --- Required ---
# Bot token (Web API identity), from "OAuth & Permissions" after install.
SLACK_BOT_TOKEN=xoxb-...
# App-level token (Socket Mode websocket), from "Basic Information" > App-Level Tokens.
SLACK_APP_TOKEN=xapp-...
# Target channel id, e.g. C0XXXXXXX. Right-click the channel > View details > bottom.
LUNCH_CHANNEL_ID=C0XXXXXXX
# Claude API key for pitch blurbs, history extraction, weekly digest.
ANTHROPIC_API_KEY=sk-ant-...

# --- Scheduling ---
TZ=America/Los_Angeles
POLL_MINUTES=10
# Toggle each meal with <NAME>_ENABLED, time it with <NAME>_TIME, and scope the
# days it runs with <NAME>_DAYS (defaults to mon-fri; also accepts sun-thu,
# mon-sat, or a list like sat,sun / mon,wed,fri).
BREAKFAST_ENABLED=0
BREAKFAST_TIME=08:30
COFFEE_ENABLED=0
COFFEE_TIME=10:30
LUNCH_ENABLED=1
LUNCH_TIME=11:30
SNACK_ENABLED=0
SNACK_TIME=15:30
DINNER_ENABLED=1
DINNER_TIME=18:00
# DINNER_DAYS=sun-thu
# Advanced: set MEALS to override the above entirely. Append @days per meal to
# scope it; omit it to default to Mon-Fri. Commas split meals, so write day
# lists with + (e.g. sat+sun). e.g.
# MEALS=brunch@10:00@sat+sun,lunch@12:00,dinner@18:30@sun-thu

# --- Storage ---
DB_PATH=data/lunchbot.db

# --- Model ---
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Recommender tunables (sensible defaults; override only if you know why) ---
RECO_PRIOR_M=8
RECO_EXPLORE_K=0.3
RECO_RECENCY_HALFLIFE_DAYS=7
# Don't re-suggest a place visited within this many days (hard floor).
RECO_COOLDOWN_DAYS=1

# --- Optional: nearby discovery for cold-start top-up ---
GOOGLE_PLACES_KEY=
OFFICE_LATLNG=
